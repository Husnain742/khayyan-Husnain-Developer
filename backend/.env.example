# ---- Copy this file to .env (local) and set the same keys in Vercel > Settings > Environment Variables ----
# NEVER commit the real values.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# The ONLY email allowed to be admin
ADMIN_EMAIL=you@example.com

# bcrypt hash of the admin password. Generate with:  npm run hash-password
# (in a local .env keep the single quotes; in the Vercel dashboard paste it WITHOUT quotes)
ADMIN_PASSWORD_HASH='$2a$12$replace_me'

# 48+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value logs the admin out everywhere.
JWT_SECRET=

# Comma separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=https://your-frontend.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
